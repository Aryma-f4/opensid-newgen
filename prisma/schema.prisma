model analisis_tipe_indikator {
  id                 Int                  @id @default(autoincrement())
  tipe               String               @db.VarChar(20)
  analisis_indikator analisis_indikator[]
}

model anggota_grup_kontak {
  id_grup_kontak Int            @id @default(autoincrement())
  config_id      Int
  id_grup        Int
  id_kontak      Int?
  id_penduduk    Int?
  created_at     DateTime?      @default(now()) @db.Timestamp(0)
  updated_at     DateTime?      @default(now()) @db.Timestamp(0)
  config         config         @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "anggota_grup_kontak_config_fk")
