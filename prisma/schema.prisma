  id_master             Int
  id_ketua              Int?
  nama                  String                  @db.VarChar(50)
  slug                  String?                 @db.VarChar(255)
  keterangan            String?                 @db.VarChar(300)
  kode                  String                  @db.VarChar(16)
  logo                  String?                 @db.VarChar(255)
  no_sk_pendirian       String?                 @db.VarChar(255)
  tipe                  String?                 @default("kelompok") @db.VarChar(100)
