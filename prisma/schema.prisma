  analisis_respon_bukti analisis_respon_bukti[] @ignore
  analisis_respon_hasil analisis_respon_hasil[] @ignore
  config                config                  @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "kelompok_config_fk")
  kelompok_master       kelompok_master         @relation(fields: [id_master], references: [id], onDelete: Cascade, map: "kelompok_kelompok_master_fk")
  tweb_penduduk         tweb_penduduk?          @relation(fields: [id_ketua], references: [id], onDelete: Cascade, map: "kelompok_ketua_fk")
  kelompok_anggota      kelompok_anggota[]

  @@unique([config_id, kode, tipe], map: "config_kode_tipe")
  @@unique([slug, config_id], map: "slug_config_tipe")
