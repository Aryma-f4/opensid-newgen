generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model agenda {
  id                   Int      @id @default(autoincrement())
  config_id            Int
  id_artikel           Int
  tgl_agenda           DateTime @default(now()) @db.Timestamp(0)
  koordinator_kegiatan String   @db.VarChar(50)
  lokasi_kegiatan      String   @db.VarChar(100)
  config               config   @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "agenda_config_fk")
  artikel              artikel  @relation(fields: [id_artikel], references: [id], onDelete: Cascade, map: "id_artikel_fk")

  @@index([config_id], map: "agenda_config_fk")
  @@index([id_artikel], map: "id_artikel_fk")
}

model alias_kodeisian {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  config_id  Int
  judul      String    @db.VarChar(20)
  alias      String    @db.VarChar(50)
  content    String    @db.VarChar(200)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  created_by Int?
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  updated_by Int?
  config     config    @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "alias_kodeisian_config_fk")

  @@unique([config_id, judul, alias], map: "alias_kodeisian_config_id_judul_alias_unique")
}

model analisis_indikator {
  id                          Int                          @id @default(autoincrement())
  config_id                   Int
  id_master                   Int?
  nomor                       String?                      @db.VarChar(10)
  pertanyaan                  String                       @db.VarChar(400)
  id_tipe                     Int?
  bobot                       Int                          @default(0) @db.TinyInt
  act_analisis                Int                          @default(2) @db.TinyInt
  id_kategori                 Int?
  is_publik                   Boolean                      @default(false)
  is_teks                     Boolean                      @default(false)
  referensi                   String?                      @db.VarChar(50)
  config                      config                       @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_indikator_config_fk")
  analisis_kategori_indikator analisis_kategori_indikator? @relation(fields: [id_kategori], references: [id], onDelete: Cascade, map: "analisis_indikator_id_kategori_fk")
  analisis_master             analisis_master?             @relation(fields: [id_master], references: [id], onDelete: Cascade, map: "analisis_indikator_master_fk")
  analisis_tipe_indikator     analisis_tipe_indikator?     @relation(fields: [id_tipe], references: [id], onDelete: Cascade, map: "analisis_indikator_tipe_fk")
  analisis_parameter          analisis_parameter[]
  analisis_respon             analisis_respon[]            @ignore

  @@index([config_id], map: "analisis_indikator_config_fk")
  @@index([id_kategori], map: "analisis_indikator_id_kategori_index")
  @@index([id_master, id_tipe], map: "analisis_indikator_id_master_id_tipe_index")
  @@index([id_tipe], map: "analisis_indikator_id_tipe_index")
}

model analisis_kategori_indikator {
  id                 Int                  @id @default(autoincrement())
  config_id          Int
  id_master          Int?
  kategori           String               @db.VarChar(50)
  kategori_kode      String?              @db.VarChar(3)
  analisis_indikator analisis_indikator[]
  config             config               @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_kategori_indikator_config_fk")
  analisis_master    analisis_master?     @relation(fields: [id_master], references: [id], onDelete: Cascade, map: "analisis_kategori_indikator_master_fk")

  @@index([config_id], map: "analisis_kategori_indikator_config_fk")
  @@index([id_master], map: "id_master")
}

model analisis_klasifikasi {
  id                   Int                    @id @default(autoincrement())
  config_id            Int
  id_master            Int?
  nama                 String                 @db.VarChar(50)
  minval               Float
  maxval               Float
  config               config                 @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_klasifikasi_config_fk")
  analisis_master      analisis_master?       @relation(fields: [id_master], references: [id], onDelete: Cascade, map: "analisis_klasifikasi_master_fk")
  analisis_partisipasi analisis_partisipasi[] @ignore

  @@index([config_id], map: "analisis_klasifikasi_config_fk")
  @@index([id_master], map: "id_master")
}

model analisis_master {
  id                          Int                           @id @default(autoincrement())
  config_id                   Int
  nama                        String                        @db.VarChar(40)
  subjek_tipe                 Int?
  lock                        Boolean                       @default(true)
  deskripsi                   String                        @db.Text
  kode_analisis               String                        @default("00000") @db.VarChar(5)
  id_kelompok                 Int?
  pembagi                     String                        @default("100") @db.VarChar(10)
  id_child                    Int?                          @db.SmallInt
  format_impor                Int?                          @db.TinyInt
  jenis                       Int                           @default(2) @db.TinyInt
  gform_id                    String?                       @db.Text
  gform_nik_item_id           String?                       @db.Text
  gform_last_sync             DateTime?                     @db.DateTime(0)
  analisis_indikator          analisis_indikator[]
  analisis_kategori_indikator analisis_kategori_indikator[]
  analisis_klasifikasi        analisis_klasifikasi[]
  config                      config                        @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_master_config_fk")
  analisis_ref_subjek         analisis_ref_subjek?          @relation(fields: [subjek_tipe], references: [id], onDelete: Cascade, map: "analisis_master_subjek_fk")
  analisis_partisipasi        analisis_partisipasi[]        @ignore
  analisis_periode            analisis_periode[]
  analisis_respon_bukti       analisis_respon_bukti[]       @ignore
  analisis_respon_hasil       analisis_respon_hasil[]       @ignore

  @@index([config_id], map: "analisis_master_config_fk")
  @@index([subjek_tipe], map: "analisis_master_subjek_fk")
}

model analisis_parameter {
  id                   Int                    @id @default(autoincrement())
  config_id            Int
  id_indikator         Int?
  jawaban              String                 @db.VarChar(200)
  nilai                Int                    @default(0)
  kode_jawaban         Int?                   @default(0)
  asign                Boolean                @default(false)
  config               config                 @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_parameter_config_fk")
  analisis_indikator   analisis_indikator?    @relation(fields: [id_indikator], references: [id], onDelete: Cascade, map: "analisis_parameter_indikator_fk")
  analisis_partisipasi analisis_partisipasi[] @ignore
  analisis_respon      analisis_respon[]      @ignore

  @@index([config_id], map: "analisis_parameter_config_fk")
  @@index([id_indikator], map: "id_indikator")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model analisis_partisipasi {
  id_subjek            Int?
  id_master            Int?
  id_periode           Int?
  id_klassifikasi      Int?
  config_id            Int?
  config               config?               @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_partisipasi_config_id_foreign")
  analisis_klasifikasi analisis_klasifikasi? @relation(fields: [id_klassifikasi], references: [id], onDelete: Cascade, map: "analisis_partisipasi_klasifikasi_fk")
  analisis_master      analisis_master?      @relation(fields: [id_master], references: [id], onDelete: Cascade, map: "analisis_partisipasi_master_fk")
  analisis_periode     analisis_periode?     @relation(fields: [id_periode], references: [id], onDelete: Cascade, map: "analisis_partisipasi_periode_fk")
  analisis_parameter   analisis_parameter?   @relation(fields: [id_subjek], references: [id], onDelete: Cascade, map: "analisis_partisipasi_subjek_fk")

  @@index([config_id], map: "analisis_partisipasi_config_id_foreign")
  @@index([id_klassifikasi], map: "id_klassifikasi")
  @@index([id_master], map: "id_master")
  @@index([id_periode], map: "id_periode")
  @@index([id_subjek, id_master, id_periode, id_klassifikasi], map: "id_subjek")
  @@ignore
}

model analisis_periode {
  id                    Int                     @id @default(autoincrement())
  config_id             Int
  id_master             Int?
  nama                  String                  @db.VarChar(50)
  id_state              Int?
  aktif                 Boolean                 @default(false)
  keterangan            String                  @db.VarChar(100)
  tahun_pelaksanaan     Int                     @db.Year
  analisis_partisipasi  analisis_partisipasi[]  @ignore
  config                config                  @relation(fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_periode_config_fk")
  analisis_master       analisis_master?        @relation(fields: [id_master], references: [id], onDelete: Cascade, map: "analisis_periode_master_fk")
  analisis_ref_state    analisis_ref_state?     @relation(fields: [id_state], references: [id], onDelete: Cascade, map: "state_fk")
  analisis_respon       analisis_respon[]       @ignore
  analisis_respon_bukti analisis_respon_bukti[] @ignore
  analisis_respon_hasil analisis_respon_hasil[] @ignore

  @@index([config_id], map: "analisis_periode_config_fk")
  @@index([id_master], map: "id_master")
  @@index([id_state], map: "id_state")
}

model analisis_ref_state {
  id               Int                @id @default(autoincrement())
  nama             String             @db.VarChar(40)
  analisis_periode analisis_periode[]
}

model analisis_ref_subjek {
  id              Int               @id @default(autoincrement())
  subjek          String            @db.VarChar(20)
  analisis_master analisis_master[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model analisis_respon {
  id_indikator                                                        Int?
  config_id                                                           Int
  id_parameter                                                        Int?
  id_subjek                                                           Int?
  id_periode                                                          Int?
  penduduk_id                                                         Int?
  keluarga_id                                                         Int?
  kelompok_id                                                         Int?
  rtm_id                                                              Int?
  desa_id                                                             Int?
  dusun_id                                                            Int?
  rw_id                                                               Int?
  rt_id                                                               Int?
  config_analisis_respon_config_idToconfig                            config                @relation("analisis_respon_config_idToconfig", fields: [config_id], references: [id], onDelete: Cascade, map: "analisis_respon_config_fk")
  config_analisis_respon_desa_idToconfig                              config?               @relation("analisis_respon_desa_idToconfig", fields: [desa_id], references: [id], onDelete: Cascade, map: "analisis_respon_desa_id_foreign")
  tweb_wil_clusterdesa_analisis_respon_dusun_idTotweb_wil_clusterdesa tweb_wil_clusterdesa? @relation("analisis_respon_dusun_idTotweb_wil_clusterdesa", fields: [dusun_id], references: [id], onDelete: Cascade, map: "analisis_respon_dusun_id_foreign")
  analisis_indikator                                                  analisis_indikator?   @relation(fields: [id_indikator], references: [id], onDelete: Cascade, map: "analisis_respon_indikator_fk")
  kelompok                                                            kelompok?             @relation(fields: [kelompok_id], references: [id], onDelete: Cascade, map: "analisis_respon_kelompok_id_foreign")
  tweb_keluarga                                                       tweb_keluarga?        @relation(fields: [keluarga_id], references: [id], onDelete: Cascade, map: "analisis_respon_keluarga_id_foreign")
  analisis_parameter                                                  analisis_parameter?   @relation(fields: [id_parameter], references: [id], onDelete: Cascade, map: "analisis_respon_parameter_fk")
  tweb_penduduk                                                       tweb_penduduk?        @relation(fields: [penduduk_id], references: [id], onDelete: Cascade, map: "analisis_respon_penduduk_id_foreign")
  analisis_periode                                                    analisis_periode?     @relation(fields: [id_periode], references: [id], onDelete: Cascade, map: "analisis_respon_periode_fk")
  tweb_wil_clusterdesa_analisis_respon_rt_idTotweb_wil_clusterdesa    tweb_wil_clusterdesa? @relation("analisis_respon_rt_idTotweb_wil_clusterdesa", fields: [rt_id], references: [id], onDelete: Cascade, map: "analisis_respon_rt_id_foreign")
  tweb_rtm                                                            tweb_rtm?             @relation(fields: [rtm_id], references: [id], onDelete: Cascade, map: "analisis_respon_rtm_id_foreign")
  tweb_wil_clusterdesa_analisis_respon_rw_idTotweb_wil_clusterdesa    tweb_wil_clusterdesa? @relation("analisis_respon_rw_idTotweb_wil_clusterdesa", fields: [rw_id], references: [id], onDelete: Cascade, map: "analisis_respon_rw_id_foreign")

  @@index([config_id], map: "analisis_respon_config_fk")
  @@index([desa_id], map: "analisis_respon_desa_id_foreign")
  @@index([dusun_id], map: "analisis_respon_dusun_id_foreign")
  @@index([kelompok_id], map: "analisis_respon_kelompok_id_foreign")
  @@index([keluarga_id], map: "analisis_respon_keluarga_id_foreign")
  @@index([penduduk_id], map: "analisis_respon_penduduk_id_foreign")
  @@index([rt_id], map: "analisis_respon_rt_id_foreign")
  @@index([rtm_id], map: "analisis_respon_rtm_id_foreign")
  @@index([rw_id], map: "analisis_respon_rw_id_foreign")
  @@index([id_indikator], map: "id_indikator")
  @@index([id_parameter, id_subjek], map: "id_parameter")
  @@index([id_periode], map: "id_periode")
  @@ignore
}

